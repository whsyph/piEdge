[Unit]
Description=Media Player Otomatis - Layar 1
After=sound.target network.target labwc.service
Requires=labwc.service

[Service]
User=pi
Type=simple
Environment=XDG_RUNTIME_DIR=/run/user/1000
Environment=WAYLAND_DISPLAY=wayland-0
ExecStart=/usr/bin/mpv --vo=gpu --gpu-context=wayland --fs --screen=0 --fs-screen=0 --profile=fast --gpu-dumb-mode=yes --video-sync=desync --loop-playlist=inf --no-audio --no-deinterlace --hwdec=v4l2m2m-copy --input-ipc-server=/tmp/mpv-layar1.sock --playlist=/home/pi/museum_video/layar1/playlist.txt
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
